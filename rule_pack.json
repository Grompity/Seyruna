    "self_gate": {
      "greetings": ["hey", "hi", "hello", "howdy", "greetings", "good morning"],
      "greeting_line": "No question at the shelf yet - greetings are free here. Ask me something.",
      "patterns": [
        {"all": ["who", "you"],
         "line": "Ascended: a shelf of records, a gate that watches the claims, and a speech that says the record's part and no more."},
        {"all": ["how", "you"],
